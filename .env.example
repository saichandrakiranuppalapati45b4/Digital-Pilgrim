# ==============================================================
# DIGITAL PILGRIM 1.0 — Global Environment Template
# ==============================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/digital_pilgrim

# JWT Authentication Secrets
JWT_SECRET=super_secret_digital_pilgrim_jwt_key_min_32_chars_long_12345
JWT_EXPIRES_IN=7d
COOKIE_SECRET=digital_pilgrim_cookie_secret_long_random_string_xyz

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=digital_pilgrim_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Initial Admin Seeding (Used exclusively by backend/scripts/createAdmin.ts)
INITIAL_ADMIN_NAME=Digital Pilgrim Administrator
INITIAL_ADMIN_EMAIL=admin@digitalpilgrim.org
INITIAL_ADMIN_PASSWORD=PilgrimAdmin#2026

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
